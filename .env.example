# Template configuration for the Game Hub server. Copy to .env and edit:
#   cp .env.example .env
# python-dotenv loads .env automatically when the app starts.

# Flask session signing + Bulls and Cows share-token crypto.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me

# Server bind address.
HOST=127.0.0.1
PORT=25001

# 1 enables the Werkzeug debugger and auto-reloader (development only).
FLASK_DEBUG=0

# Per-user cap for saved bingo cards (5 MB).
BINGO_MAX_USER_BYTES=5242880

# Idle remote games are swept from memory after this many seconds (6 hours).
# Set to 0 to disable sweeping.
GAME_TTL_SECONDS=21600

# How often the sweeper runs, in seconds.
GAME_SWEEP_INTERVAL_SECONDS=300
